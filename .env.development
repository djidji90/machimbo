# ----------------------
# Seguridad
# ----------------------
SECRET_KEY=clave_de_desarrollo_segura
JWT_SECRET_KEY=clave_jwt_desarrollo
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ----------------------
# Base de datos SQLite (desarrollo)
# ----------------------
# Puedes usar SQLite para desarrollo, no necesitas DATABASE_URL
# Si quieres PostgreSQL local, descomenta y configura
# DATABASE_URL=postgresql://user:password@localhost:5432/mi_db_local

# ----------------------
# Redis (desarrollo)
# ----------------------
REDIS_URL=redis://:<REDIS_PASSWORD>@<REDIS_HOST>:6379/1
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# ----------------------
# CORS
# ----------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000
